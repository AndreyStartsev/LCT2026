# Лимит тела запроса nginx следует за лимитом пакета: MAX_PACKAGE_MB плюс запас
# на заголовки multipart. Скрипт с расширением .envsh точка входа образа nginx
# выполняет в своей оболочке, поэтому переменная доживает до подстановки шаблона.
# Задать лимит напрямую можно переменной MAX_BODY_MB.
export MAX_BODY_MB="${MAX_BODY_MB:-$(( ${MAX_PACKAGE_MB:-200} + 10 ))}"
