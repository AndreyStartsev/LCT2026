# Образец настроек: скопируйте в .env рядом с docker-compose.yml. Файл .env в репозиторий не попадает.

# Токен доступа к закрытым правилам Матрицы: по нему сборка воркера их выкачивает (rules/README.md).
# Без токена воркер не соберётся, если правил нет в папке rules/.
RULES_TOKEN=

# Модель для сканов без текста и чертежей с тонким текстовым слоем — в контуре заказчика, документы
# наружу не уходят. Свой сервер с API OpenAI (vLLM, Ollama, SGLang, llama.cpp) подключается надстройкой:
#   docker compose -f docker-compose.yml -f deploy/docker-compose.llm-external.yml up -d --build
# Без модели страницы читаются текстовым слоем и распознаванием Tesseract.
# LLM_URL=http://model-host:8000/v1/chat/completions
# LLM_MODEL=qwen/qwen3.6-27b
# LLM_SERVER=vllm
# LLM_API_KEY=

# Веб-клиент открыт только этой машине; 0.0.0.0 — открыть в сеть
# WEB_BIND=127.0.0.1

# Учётные записи «логин:пароль:роль» через запятую; по умолчанию стендовые inspector, admin, expert
# AUTH_USERS=inspector:<пароль>:inspector,admin:<пароль>:admin
