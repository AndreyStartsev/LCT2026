# Образец настроек: скопируйте в .env рядом с docker-compose.yml. Файл .env в репозиторий не попадает.

# Токен доступа к закрытым правилам Матрицы: по нему сборка воркера их выкачивает (rules/README.md).
# Без токена воркер не соберётся, если правил нет в папке rules/.
RULES_TOKEN=

# Модель для сканов без текста и чертежей с тонким текстовым слоем. В контуре заказчика это свой
# сервер модели с API в формате OpenAI chat/completions; документы наружу не уходят.
# Без модели страницы читаются текстовым слоем и распознаванием Tesseract.
# PIPELINE_MODEL_URL=http://model-server:8000/v1/chat/completions
# PIPELINE_MODEL_NAME=qwen/qwen3.6-27b
# Какие модели предлагать инспектору на экране загрузки: «id=Название» через запятую
# PIPELINE_MODEL_CHOICES=qwen/qwen3.6-27b=Qwen3.6 27B
# Ключ, если сервер модели его требует
# INSPECTOR_OPENROUTER_API_KEY=

# Учётные записи «логин:пароль:роль» через запятую; по умолчанию стендовые inspector, admin, expert
# AUTH_USERS=inspector:<пароль>:inspector,admin:<пароль>:admin
