# Настройки поставки на стенд проверки. Скопировать в корень репозитория как .env:
#   cp deploy/release.env.example .env
# docker compose читает .env сам. Всё ниже необязательно: без .env работают значения
# по умолчанию из deploy/docker-compose.release.yml, подобранные под одну H100 80 ГБ и 24 ядра.

# Образы: реестр и тег поставки (тег — в манифесте архива, MANIFEST.txt)
INSPECTOR_REGISTRY=inspector-release
INSPECTOR_TAG=latest

# Папка с объектами и реестром организатора (files_index.jsonl) и папка для файла сдачи
INSPECTOR_INPUT=./input
INSPECTOR_OUTPUT=./output

# Видеокарта: номер карты хоста и доля её памяти. Пусто — доля считается от свободной
# памяти при запуске, не больше LLM_GPU_MEMORY_MAX (карту могут делить с другими).
LLM_GPU=0
LLM_GPU_MEMORY_UTILIZATION=
LLM_GPU_MEMORY_MAX=0.85

# Сколько страниц модель читает одновременно и сколько процессов читают страницы
LLM_MAX_NUM_SEQS=32
PIPELINE_PAGE_WORKERS=20
PIPELINE_OCR_WORKERS=20

# Веб-клиент открыт только этой машине; 0.0.0.0 — открыть в сеть
WEB_BIND=127.0.0.1

# Учётные записи (логин:пароль:роль). Вход в веб-клиент по умолчанию: inspector / inspector
AUTH_USERS=inspector:inspector:inspector,admin:admin:admin

# Запасной адрес модели — OpenRouter — включается только ключом. На стенде проверки ключа
# нет: внешних вызовов нет, а без своей модели объект читается распознаванием.
INSPECTOR_OPENROUTER_API_KEY=
